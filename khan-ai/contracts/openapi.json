{
  "openapi": "3.0.3",
  "info": {
    "title": "KHAN AI Service API",
    "version": "0.1.1",
    "description": "Contract-first API for the KHAN AI agent core. Interfaces only; no deployed backend is implied."
  },
  "servers": [{"url": "http://127.0.0.1:8787", "description": "Local development placeholder"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "security": [],
        "responses": {"200": {"description": "Service health", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}
      }
    },
    "/v1/chat": {
      "post": {
        "operationId": "createChat",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChatRequest"}}}},
        "responses": {"200": {"description": "Assistant response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChatResponse"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}
      }
    },
    "/v1/agent/run": {
      "post": {
        "operationId": "runAgent",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentRunRequest"}}}},
        "responses": {"200": {"description": "Agent run result or current state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentRunResponse"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}}
      }
    },
    "/v1/agent/runs/{runId}": {
      "get": {
        "operationId": "getAgentRun",
        "parameters": [{"name": "runId", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 128}}],
        "responses": {"200": {"description": "Current run state/result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentRunResponse"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "404": {"description": "Run not found"}}
      }
    },
    "/v1/memory": {
      "get": {
        "operationId": "listMemory",
        "parameters": [
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}},
          {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 512}},
          {"name": "category", "in": "query", "schema": {"type": "string", "maxLength": 64}}
        ],
        "responses": {"200": {"description": "Paged memory entries", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemoryListResponse"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}
      },
      "post": {
        "operationId": "createMemory",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemoryWriteRequest"}}}},
        "responses": {"201": {"description": "Memory created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemoryEntry"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}
      }
    },
    "/v1/tools/authorize": {
      "post": {
        "operationId": "authorizeTool",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolAuthorizationRequest"}}}},
        "responses": {"200": {"description": "Authorization decision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolAuthorizationResponse"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "responses": {
      "BadRequest": {"description": "Invalid request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Unauthorized": {"description": "Authentication required"},
      "Forbidden": {"description": "Authenticated caller is not authorized for the requested action"}
    },
    "schemas": {
      "HealthResponse": {"type": "object", "required": ["status", "version"], "properties": {"status": {"type": "string", "enum": ["ok", "degraded"]}, "version": {"type": "string"}}},
      "ChatRequest": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string", "minLength": 1, "maxLength": 12000}, "sessionId": {"type": "string", "maxLength": 128}}},
      "ChatResponse": {"type": "object", "required": ["message", "requestId"], "properties": {"message": {"type": "string"}, "sessionId": {"type": "string"}, "requestId": {"type": "string"}}},
      "AgentRunRequest": {"type": "object", "required": ["task", "permissionLevel"], "properties": {"task": {"type": "string", "minLength": 1, "maxLength": 12000}, "sessionId": {"type": "string", "maxLength": 128}, "permissionLevel": {"type": "string", "enum": ["read", "prepare", "confirm", "execute"]}, "authorizationDecisionId": {"type": "string", "maxLength": 128, "description": "Required when permissionLevel is execute or when the server requires a prior confirmation decision. The server must validate that the decision authorizes this task/tool scope before execution."}}},
      "AgentRunResponse": {"type": "object", "required": ["runId", "status", "steps"], "properties": {"runId": {"type": "string"}, "status": {"type": "string", "enum": ["planned", "running", "completed", "blocked", "failed"]}, "steps": {"type": "array", "items": {"$ref": "#/components/schemas/AgentStep"}}, "result": {"$ref": "#/components/schemas/AgentResult"}}},
      "AgentResult": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/components/schemas/Evidence"}}}},
      "Evidence": {"type": "object", "required": ["source", "claim"], "properties": {"source": {"type": "string", "format": "uri"}, "claim": {"type": "string"}}},
      "AgentStep": {"type": "object", "required": ["id", "kind", "status"], "properties": {"id": {"type": "string"}, "kind": {"type": "string", "enum": ["plan", "tool", "verify", "respond"]}, "status": {"type": "string", "enum": ["pending", "running", "completed", "blocked", "failed"]}, "summary": {"type": "string"}}},
      "MemoryWriteRequest": {"type": "object", "required": ["content"], "properties": {"content": {"type": "string", "minLength": 1, "maxLength": 4000}, "category": {"type": "string", "maxLength": 64}, "source": {"type": "string", "maxLength": 64}}},
      "MemoryEntry": {"type": "object", "required": ["id", "content", "createdAt"], "properties": {"id": {"type": "string"}, "content": {"type": "string"}, "category": {"type": "string"}, "source": {"type": "string"}, "createdAt": {"type": "string", "format": "date-time"}}},
      "MemoryListResponse": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/MemoryEntry"}}, "nextCursor": {"type": "string"}}},
      "ToolAuthorizationRequest": {"type": "object", "required": ["tool", "permissionLevel"], "properties": {"tool": {"type": "string", "minLength": 1, "maxLength": 128}, "permissionLevel": {"type": "string", "enum": ["read", "prepare", "confirm", "execute"]}, "reason": {"type": "string", "maxLength": 1000}}},
      "ToolAuthorizationResponse": {"type": "object", "required": ["decision", "decisionId"], "properties": {"decision": {"type": "string", "enum": ["allow", "deny", "confirm"]}, "decisionId": {"type": "string", "maxLength": 128}}},
      "ErrorResponse": {"type": "object", "required": ["error", "message"], "properties": {"error": {"type": "string"}, "message": {"type": "string"}, "requestId": {"type": "string"}}}
    }
  }
}
