{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence OS public API contract",
  "description": "Contract for the future server-side Evidence OS boundary. This file contains no credentials, secrets, private data, or implementation logic.",
  "version": "0.1.0",
  "operations": {
    "inspectClaim": {
      "method": "POST",
      "path": "/v1/claims/inspect",
      "request": {
        "type": "object",
        "required": ["claim"],
        "properties": {
          "claim": {"type": "string", "minLength": 1, "maxLength": 2000},
          "topic": {"type": "string", "maxLength": 200}
        },
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "required": ["status", "confidence", "evidence"],
        "properties": {
          "status": {"enum": ["Verified", "Supported", "Unverified", "Disputed"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array"},
          "provenance": {"type": "object"}
        }
      }
    }
  },
  "security": {
    "transport": "HTTPS only",
    "credentials": "Server-side only; never shipped to browser",
    "secrets": "Environment/secret-manager only",
    "rateLimit": "Required",
    "logging": "Do not log secrets or private user content",
    "cors": "Allow only explicitly configured origins",
    "publicResponse": "Return the minimum data required by the public interface"
  }
}
